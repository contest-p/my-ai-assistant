# 이 파일을 복사해서 .env로 이름을 바꾸고 실제 값을 채워넣으세요.
# .env는 .gitignore에 포함되어 있어서 GitHub에는 올라가지 않습니다.

OPENAI_API_KEY=
# 모델명은 Phase 6(AI 연동 구현)에서 결정합니다. 그전까지는 비워두세요.
OPENAI_MODEL=
# Firebase 서비스 계정 JSON 파일 내용을 한 줄로(줄바꿈 없이) 붙여넣으세요.
FIREBASE_SERVICE_ACCOUNT_JSON=
# 개발 중에는 * 로 둡니다. 배포 직전(Phase 9)에 실제 Vercel 도메인으로 좁힙니다.
ALLOWED_ORIGINS=*
